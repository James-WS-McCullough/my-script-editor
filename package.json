{
  "name": "my-script-editor",
  "version": "0.1.0",
  "private": true,
  "main": "./dist-electron/main.js",
  "homepage": "./",
  "dependencies": {
    "@chakra-ui/icons": "^2.1.0",
    "@chakra-ui/react": "^2.8.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.7",
    "@mui/material": "^5.14.7",
    "@supabase/supabase-js": "^2.38.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.47",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/uuid": "^9.0.5",
    "axios": "^1.5.0",
    "compressorjs": "^1.2.1",
    "framer-motion": "^10.16.2",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "uuid": "^9.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && concurrently \"npm start\" \"wait-on http://localhost:3000 && NODE_ENV=development electron .\"",
    "electron:start": "npm run electron:build && electron .",
    "dist": "npm run build && npm run electron:build && electron-builder",
    "dist:mac": "npm run build && npm run electron:build && electron-builder --mac",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win",
    "dist:linux": "npm run build && npm run electron:build && electron-builder --linux",
    "deploy": "npm run build && npm run electron:build && electron-builder --mac --dir && open release/mac-arm64/Script\\ Editor.app",
    "deploy:install": "npm run build && npm run electron:build && electron-builder --mac && open release"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.48.0",
    "supabase": "^1.100.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.scripteditor.app",
    "productName": "Script Editor",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "build/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build-resources/icon.png"
    }
  }
}
